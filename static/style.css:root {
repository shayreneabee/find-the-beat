    --bg-main: #f7f2e8;
    --bg-soft: #fffaf1;
    --panel: rgba(255, 255, 255, 0.82);
    --panel-strong: rgba(255, 255, 255, 0.94);
    --border: rgba(148, 120, 74, 0.18);
    --text-main: #2d1f12;
    --text-soft: #6f5a42;
    --accent: #8c6a3d;
    --accent-strong: #b4884c;
    --gold-soft: #e6d2a2;
    --shadow: 0 18px 44px rgba(98, 69, 29, 0.14);
    --radius-xl: 24px;
    --radius-lg: 18px;
    --radius-md: 14px;
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text-main);
    background:
        radial-gradient(circle at top left, rgba(230, 210, 162, 0.55), transparent 28%),
        radial-gradient(circle at top right, rgba(196, 164, 132, 0.28), transparent 26%),
        linear-gradient(180deg, #fbf7ef 0%, #f4ecdf 100%);
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: rgba(255, 250, 241, 0.82);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    width: min(1180px, 92%);
    margin: 0 auto;
    padding: 24px 0 18px;
}

.brand-block {
    margin-bottom: 18px;
}

.brand-kicker {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
}

.brand-name {
    display: inline-block;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
    color: #3a2815;
}

.brand-subtitle {
    margin: 0;
    color: var(--text-soft);
    font-size: 1rem;
}

.main-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.nav-pill {
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--border);
    color: var(--text-main);
    font-weight: 600;
    transition: all 0.18s ease;
    box-shadow: 0 6px 18px rgba(164, 129, 79, 0.08);
}

.nav-pill:hover {
    background: var(--panel-strong);
    border-color: rgba(180, 136, 76, 0.45);
    transform: translateY(-1px);
}

.page-shell {
    width: min(1180px, 92%);
    margin: 28px auto 48px;
}

.flash-stack {
    display: grid;
    gap: 12px;
    margin-bottom: 22px;
}

.flash-card {
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(180, 136, 76, 0.12);
    border: 1px solid rgba(180, 136, 76, 0.24);
    box-shadow: var(--shadow);
}

.hero-card,
.content-card,
.form-card,
.card-link,
.message-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow);
}

.hero-card,
.content-card,
.form-card {
    padding: 28px;
}

.hero-title {
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1.05;
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.04em;
}

.hero-subtitle {
    margin: 0;
    color: var(--text-soft);
    font-size: 1.02rem;
    max-width: 760px;
}

.grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.card-link,
.message-item {
    display: block;
    padding: 20px;
    transition: all 0.18s ease;
}

.card-link:hover,
.message-item:hover {
    background: var(--panel-strong);
    transform: translateY(-2px);
}

.card-title,
.item-title {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 0 0 6px;
    color: #3a2815;
}

.card-meta,
.item-meta,
.muted {
    color: var(--text-soft);
    font-size: 0.95rem;
}

label {
    display: block;
    font-weight: 600;
    margin: 14px 0 8px;
    color: var(--text-soft);
}

input,
textarea,
select {
    width: 100%;
    padding: 13px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-main);
    font-size: 1rem;
    outline: none;
}

input:focus,
textarea:focus,
select:focus {
    border-color: rgba(180, 136, 76, 0.6);
    background: #fffdf8;
}

textarea {
    resize: vertical;
    min-height: 120px;
}

input::placeholder,
textarea::placeholder {
    color: #9b8568;
}

button,
.primary-btn {
    appearance: none;
    border: none;
    border-radius: var(--radius-md);
    padding: 12px 18px;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: white;
    transition: all 0.18s ease;
}

button:hover,
.primary-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
}

.secondary-btn {
    display: inline-block;
    border-radius: var(--radius-md);
    padding: 12px 18px;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.65);
    color: var(--text-main);
    border: 1px solid var(--border);
    transition: all 0.18s ease;
}

.secondary-btn:hover {
    background: var(--panel-strong);
}

.danger-btn {
    display: inline-block;
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    background: #8f3d2e;
    color: white;
    border: none;
    transition: all 0.18s ease;
}

.danger-btn:hover {
    filter: brightness(1.05);
}

.media-frame,
.video-frame {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    display: block;
}

.thread-stack {
    display: grid;
    gap: 14px;
}

.thread-bubble {
    padding: 16px 18px;
    border-radius: 18px;
    max-width: 780px;
    border: 1px solid var(--border);
}

.thread-bubble.mine {
    margin-left: auto;
    background: rgba(180, 136, 76, 0.14);
}

.thread-bubble.theirs {
    background: rgba(255, 255, 255, 0.72);
}

.site-footer {
    width: min(1180px, 92%);
    margin: 0 auto 28px;
    color: var(--text-soft);
    font-size: 0.95rem;
    text-align: center;
}

.inline-form {
    display: inline;
}

@media (max-width: 980px) {
    .grid-3,
    .grid-2 {
        grid-template-columns: 1fr;
    }

    .header-inner {
        padding-top: 18px;
    }

    .hero-card,
    .content-card,
    .form-card {
        padding: 22px;
    }
}
