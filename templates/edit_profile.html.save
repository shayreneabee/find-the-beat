{% extends "base.html" %}
{% block content %}

<section class="hero">
  <h1>Edit Profile</h1>
  <p class="subtitle">Update your photo, add a video, or refresh your info.</p>

  <div class="btn-row">
    <a class="btn secondary" href="/profiles/{{ p.id }}">Back to Profile</a>
    <a class="btn secondary" href="/profiles">Showcase</a>
  </div>
</section>

<section class="apps">
  <div class="card">
    {% if error %}<p style="color:crimson;"><strong>{{ error }}</strong></p>{% endif %    <form method="POST" enctype="multipart/form-data">
      <label>Name / Stage name</label>
      <input class="input" name="name" required value="{{ p.name }}">

      <label>City</label>
      <input class="input" name="city" required value="{{ p.city }}">

      <label>Role</label>
      <input class="input" name="role" required value="{{ p.role }}">

      <label>Genre (optional)</label>
      <input class="input" name="genre" value="{{ p.genre or '' }}">

      <label>Bio (optional)</label>
      <textarea class="input" name="bio" rows="5">{{ p.bio or '' }}</textarea>

      <label>Replace profile photo (optional)</label>
      <input class="input" type="file" name="photo" accept="image/*">

      <label>Showcase video link (YouTube/Vimeo) (optional)</label>
      <input class="input" name="video_url" value="{{ p.video_url or '' }}">

      <div class="btn-row">
        <button class="btn primary" type="submit">Save changes</button>
        <a class="btn secondary" href="/profiles/{{ p.id }}">Cancel</a>
      </div>

      <p class="small">Tip: Add a YouTube link and your profile will show “🎥 Video available.”</p>
    </form>
  </div>
</section>

{% endblock %}

